# NexTrade AI Platform - Environment Variables

# ===========================
# Application
# ===========================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# ===========================
# Database - PostgreSQL
# ===========================
DATABASE_URL=postgresql://nextrade:nextrade_secret@localhost:5432/nextrade?schema=public

# ===========================
# Redis
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================
# JWT Authentication
# ===========================
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===========================
# OpenAI API
# ===========================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024

# ===========================
# Email (SMTP)
# ===========================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@nextrade.io

# ===========================
# CORS
# ===========================
CORS_ORIGIN=http://localhost:3000

# ===========================
# Rate Limiting
# ===========================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================
# Admin Seed
# ===========================
ADMIN_EMAIL=admin@nextrade.io
ADMIN_PASSWORD=Admin@123456
